rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /quizzes/{quizId} {
      // Anyone can read a quiz. Nobody can change one from a web page --
      // quizzes are written in the Firebase console, which skips these rules.
      allow read: if true;
      allow write: if false;

      match /responses/{uid} {
        // Anyone can read everyone's responses.
        allow read: if true;

        // You can only write the response whose ID is your own uid,
        // signed in with a school account, and it has to look like a
        // response: an "answers" list, plus optionally your real name.
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email.matches('.*@innovationcharter[.]org$')
          && request.resource.data.keys().hasOnly(['answers', 'name', 'submittedAt'])
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 20
          && (!('name' in request.resource.data)
              || request.resource.data.name == request.auth.token.name);

        // Nobody deletes a response.
        allow delete: if false;
      }
    }
  }
}
