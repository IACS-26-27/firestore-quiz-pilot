rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSchoolAccount() {
      return request.auth != null
        && request.auth.token.email.matches('.*@innovationcharter[.]org$');
    }

    match /quizzes/{quizId} {
      // Anyone can read a quiz.
      allow read: if true;

      // Anyone with a school account can make a quiz, with themselves as
      // the author. Only the author can change or delete it. Quizzes with
      // no author (like quiz-1, made in the console) can't be changed from
      // a web page.
      allow create: if isSchoolAccount()
        && request.resource.data.author == request.auth.uid;
      allow update, delete: if isSchoolAccount()
        && resource.data.author == request.auth.uid;

      match /responses/{uid} {
        // Anyone can read everyone's responses.
        allow read: if true;

        // Only you can write your own response, and it needs a name (text)
        // and answers (a list).
        allow create, update: if isSchoolAccount()
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.answers is list;
        allow delete: if isSchoolAccount()
          && request.auth.uid == uid;
      }
    }
  }
}
