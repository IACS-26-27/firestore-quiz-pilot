rules_version = '2';

// Paste this into the Firebase Console -> Firestore Database -> Rules tab,
// then click Publish. This is what actually protects your data -- not
// firebase-config.js, which is public on purpose.
service cloud.firestore {
  match /databases/{database}/documents {
    match /quizzes/{quizId} {
      // Anyone can read the quiz (the questions themselves).
      allow read: if true;

      // Nobody writes a quiz through the app. You author it by hand in the
      // Firestore console, which uses your own Google account's permissions
      // and is NOT subject to these rules at all -- rules only govern
      // requests made through the client SDK (i.e. from app.js).
      allow write: if false;

      match /responses/{uid} {
        // Anyone can read responses -- that's what lets the page show
        // everyone's answers (and, later, turn it into a "guess whose
        // answer is whose" game).
        allow read: if true;

        // You may only ever create or overwrite the response document
        // whose ID is YOUR OWN uid, AND only with an @innovationcharter.org
        // account. There is no document path that lets you write to
        // someone else's response, and no shared counter anywhere to race
        // or spoof.
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.token.email.matches('.*@innovationcharter[.]org$');

        // Nobody deletes a response once it exists.
        allow delete: if false;
      }
    }
  }
}
